generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id String @id @default(uuid())
  courses     Courses @relation(fields: [courseId], references: [id])
  courseId     String

  email    String @unique
  cpf      String 
  cnpj     String 
  address  String
  password String
  name     String
  phone    String
  status   Boolean
  role Role @default(USER)

  jobs         UserJobs[]
  @@map("users")

}

model Jobs {
  id           String @id @default(uuid())
  courses     Courses @relation(fields: [courseId], references: [id])
  courseId     String

  enterprise   String 
  owner        String 
  description  String @db.VarChar(1000)
  published    DateTime @default(now())
  active	     Boolean @default(true)
  quantity     Int
  place        String  

  user         UserJobs[]    
  @@map("jobs") 
}

model UserJobs {
  user           User @relation(fields: [userId], references: [id])
  userId         String
  jobs           Jobs @relation(fields: [jobsId], references: [id])
  jobsId         String

  @@id([userId, jobsId])
}

model Courses{
  id           String @id @default(uuid())

  name         String 
  level        String
  modality     String
  duration     String
  description  String @db.VarChar(1000)
  area         String

  jobs        Jobs[]
  users       User[]

  @@map("courses") 
}

enum Role{
  USER
  ENTERPRISE
  SENAC
  ADMIN

  @@map("_Role")
}
