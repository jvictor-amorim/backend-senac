generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())

  email    String @unique
  password String

  firstname String
  lastname String
  role Role @default(USER)
  @@map("users")

}

enum Role{
  USER
  ENTERPRISE
  SENAC
  ADMIN

  @@map("_Role")
}
